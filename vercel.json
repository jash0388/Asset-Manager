{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/qr-attendance run build && pnpm --filter @workspace/api-server run build:vercel",
  "outputDirectory": "artifacts/qr-attendance/dist/public",
  "framework": null,
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/FacultyApp.apk", "dest": "/FacultyApp.apk" },
    { "src": "/version.json", "dest": "/version.json" },
    { "src": "/app-version.json", "dest": "/app-version.json" },
    { "src": "/update.json", "dest": "/update.json" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/api", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
