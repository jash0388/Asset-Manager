{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/qr-attendance run build && pnpm --filter @workspace/api-server run build:vercel",
  "outputDirectory": "artifacts/qr-attendance/dist/public",
  "framework": null,
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/faculty/(.*)", "destination": "/api/index.js" },
    { "source": "/mentor/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api|faculty-portal|faculty|mentor|.*\\.apk|.*\\.json|.*\\.svg|.*\\.jpg|.*\\.js|.*\\.css).*)", "destination": "/index.html" }
  ]
}
